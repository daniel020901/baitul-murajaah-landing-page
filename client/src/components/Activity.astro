---
import StarBorder from '@/components/ui/Starborder';
import "@/styles/global.css";
// Data lokasi cabang / halaqah — tambah/ubah di sini, grid otomatis menyesuaikan
const locations = [
  {
    no: '01',
    tag: 'Majelis Pusat',
    title: 'Mihrab Masyayikh',
    place: 'Kediaman KH. Deden (Cibinong)',
    program: 'Talaqqi Sanad & Konsultasi',
    // lucide: book-open
    icon: [
      'M12 7v14',
      'M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z',
    ],
  },
  {
    no: '02',
    tag: 'Dauroh Intensif',
    title: 'Dauroh Murojaah',
    place: 'Masjid Nur Inka',
    program: "Halaqah Tasmi' & Kajian Umum",
    // lucide: moon-star
    icon: ['M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9', 'M20 3v4', 'M22 5h-4'],
  },
  {
    no: '03',
    tag: 'Camp Alam',
    title: 'Murojaah Camp',
    place: 'Taman Jati Kembang Sepatu',
    program: 'Karantina Mutqin Terbuka',
    // lucide: tent
    icon: ['M3.5 21 14 3', 'M20.5 21 10 3', 'M15.5 21 12 15l-3.5 6', 'M2 21h20'],
  },
  {
    no: '04',
    tag: 'Asrama Santri',
    title: 'Baitul Murojaah',
    place: 'Kampus Pesantren Utama',
    program: 'Kurikulum 1 Tahun Muqim',
    // lucide: school
    icon: [
      'M14 21v-3a2 2 0 0 0-4 0v3',
      'M18 5v16',
      'm4 6 7.106-3.79a2 2 0 0 1 1.788 0L20 6',
      'm6 11-3.52 2.147a1 1 0 0 0-.48.854V19a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a1 1 0 0 0-.48-.853L18 11',
      'M6 5v16',
      'M14 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0',
    ],
  },
];
---

<!-- ================= PUSAT KEGIATAN & LIVE HIGHLIGHT ================= -->
<section id="kegiatan" class="py-20 md:py-28 relative z-10">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8">

    <!-- Header Section -->
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-12">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary text-secondary-foreground text-xs uppercase tracking-widest font-semibold mb-3">
        Pusat Kegiatan &amp; Persebaran
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground uppercase mb-4">
        Titik Majelis &amp; Siaran Langsung
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        Pantau siaran tasmi' santri secara langsung serta temukan lokasi halaqah dan dauroh resmi kami.
      </p>
    </div>

    <!-- 1. LIVE HIGHLIGHT BANNER (Tampil jika ada event/live YT) -->
    <div class="live-banner relative isolate overflow-hidden rounded-[2rem] p-6 sm:p-10 lg:p-12 mb-20 text-white  ring-1 ring-amber-300/30">

      <!-- Background: banner_yt.jpg -->
      <img
        src="/banner_yt.jpg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      <!-- Overlay merah tua agar teks tetap terbaca, sisi kanan tetap memperlihatkan ornamen banner -->
      <div class="absolute inset-0 -z-10 bg-linear-to-r from-[#3a0509]/95 via-[#6d0b14]/70 to-[#7f1d1d]/25"></div>
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/45 via-transparent to-black/10"></div>

      <!-- Pola geometri islami (girih 8 titik) -->
      <div class="islamic-pattern absolute inset-0 -z-10 opacity-[0.12] pointer-events-none"></div>

      <!-- Bingkai emas bagian dalam -->
      <div class="pointer-events-none absolute inset-3 sm:inset-4 rounded-[1.6rem] border border-amber-300/25"></div>

      <!-- Rosette 8 titik berputar (dekoratif) -->
      <svg class="hero-spin pointer-events-none absolute -left-20 -bottom-20 -z-10 h-72 w-72 text-amber-300/20" viewBox="0 0 100 100" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="0.8">
          <rect x="20" y="20" width="60" height="60" />
          <rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)" />
          <rect x="30" y="30" width="40" height="40" />
          <rect x="30" y="30" width="40" height="40" transform="rotate(45 50 50)" />
          <circle cx="50" cy="50" r="12" />
          <circle cx="50" cy="50" r="44" stroke-dasharray="2 3" />
        </g>
      </svg>

      <!-- Glow emas -->
      <div class="pointer-events-none absolute -top-32 left-1/3 -z-10 h-96 w-96 rounded-full bg-amber-400/20 blur-3xl"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

        <!-- Kiri: Keterangan Siaran & Status -->
        <div class="lg:col-span-5 space-y-5">
          <!-- Badge LIVE Berkedip -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-black/25 backdrop-blur-md text-white border border-amber-300/40 text-xs font-bold tracking-wide">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
            </span>
            SEDANG SIARAN LANGSUNG
          </div>

          <p lang="ar" dir="rtl" class="text-xl sm:text-2xl text-amber-200/90 leading-none">
           وَاِذَا قُرِئَ الْقُرْاٰنُ فَاسْتَمِعُوْا لَهٗ وَاَنْصِتُوْا لَعَلَّكُمْ تُرْحَمُوْنَ
          </p>

          <h3 class=" text-2xl sm:text-3xl lg:text-4xl font-bold leading-snug">
            Tasmi' Al-Qur'an 
            <span class="bg-linear-to-r from-amber-200 via-amber-300 to-yellow-500 bg-clip-text text-transparent">  Bil Ghoib </span>
            Sekali Duduk
          </h3>

          <!-- Ornamen pemisah emas -->
          <div class="flex items-center gap-3 text-amber-300/80" aria-hidden="true">
            <span class="h-px w-14 bg-linear-to-r from-transparent to-amber-300/70"></span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 100 100"><g fill="currentColor"><rect x="20" y="20" width="60" height="60" /><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)" /></g></svg>
            <span class="h-px w-14 bg-linear-to-l from-transparent to-amber-300/70"></span>
          </div>

          <p class="text-sm sm:text-base text-amber-50/80 leading-relaxed">
            Menyimak hafalan santri Baitul Murojaah secara live streaming dari Masjid Nur Inka. Mari bersama menyimak dan mengambil berkah bacaan.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-5">
            <StarBorder
              client:visible
              as="a"
              href="https://youtu.be/PDJLvF1dUek?si=yxraezb6MaQDtdTG"
              target="_blank"
              rel="noopener noreferrer"
              theme="dark"
              color="#fde68a"
              trailColor="#f59e0b"
              backgroundColor="linear-gradient(135deg, #dc2626 0%, #991b1b 55%, #7f1d1d 100%)"
              textColor="#ffffff"
              borderColor="rgba(252, 211, 77, 0.35)"
              radius={999}
              thickness={1.5}
              stars={2}
              glow={0.8}
              sparkle
              hover="lap"
              className="yt-star-btn text-sm "
            >
              <svg class="yt-icon w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              Buka di YouTube
            </StarBorder>

            <span class="inline-flex items-center gap-1.5 text-xs text-amber-100/75 font-mono">
              <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                <path d="M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
              </svg>
              Baitul Murojaah 
            </span>
          </div>
        </div>

        <!-- Kanan: Embed Player / Thumbnail YouTube Langsung -->
        <div class="lg:col-span-7">
          <div class="relative rounded-[1.4rem] p-1.5 bg-linear-to-br from-amber-200/70 via-amber-500/30 to-amber-200/60 shadow-2xl shadow-black/40">
            <!-- Ornamen bintang di setiap sudut bingkai -->
            {['-top-2 -left-2', '-top-2 -right-2', '-bottom-2 -left-2', '-bottom-2 -right-2'].map((pos) => (
              <svg class={`absolute ${pos} z-10 h-5 w-5 text-amber-300 drop-shadow`} viewBox="0 0 100 100" aria-hidden="true">
                <g fill="currentColor"><rect x="20" y="20" width="60" height="60" /><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)" /></g>
              </svg>
            ))}
            <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black">
              <!-- Ganti VIDEO_ID dengan ID stream YouTube aktif -->
              <iframe
                class="w-full h-full"
                src="https://www.youtube.com/embed/PDJLvF1dUek?si=6tl7tmK_7zSjtWvu"
                title="YouTube Live Tasmi"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- 2. GRID LOKASI CABANG / HALAQAH -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-rose-500">
         <span class="text-xs font-mono font-bold tracking-[0.25em] uppercase">Lokasi Halaqah</span>
        </div>
        <h3 class="mt-2  text-2xl sm:text-3xl font-bold text-foreground">Temukan Majelis Kami</h3>
      </div>
      
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 cursor-pointer">
      {locations.map((loc) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-border bg-card p-6 sm:p-7 shadow-xs transition-all duration-500 ease-out hover:-translate-y-1.5 hover:border-rose-300/70 hover:shadow-xl dark:hover:border-rose-400/40">

          <!-- Garis aksen atas -->
          <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-linear-to-r from-rose-500 via-amber-400 to-rose-500 transition-transform duration-500 group-hover:scale-x-100"></span>

          <!-- Rosette islami di sudut -->
          <svg class="pointer-events-none absolute -right-12 -top-12 h-44 w-44 text-rose-500 opacity-[0.06] transition-all duration-700 group-hover:rotate-45 group-hover:opacity-[0.16]" viewBox="0 0 100 100" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="20" y="20" width="60" height="60" />
              <rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)" />
              <rect x="32" y="32" width="36" height="36" />
              <rect x="32" y="32" width="36" height="36" transform="rotate(45 50 50)" />
              <circle cx="50" cy="50" r="9" />
            </g>
          </svg>

          <!-- Nomor besar -->
          <span class="pointer-events-none absolute right-6 bottom-20  text-6xl font-bold text-foreground/[0.04] transition-colors duration-500 group-hover:text-rose-500/10">
            {loc.no}
          </span>

          <!-- Ikon -->
          <div class="relative grid h-12 w-12 place-items-center rounded-2xl bg-linear-to-br from-rose-500 to-red-800 text-amber-200  ring-1 ring-amber-300/40 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {loc.icon.map((d) => <path d={d} />)}
            </svg>
          </div>

          <!-- Label kategori -->
          <span class="relative mt-6 inline-flex w-fit items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-[0.18em] text-rose-600 ring-1 ring-rose-200/70 dark:bg-rose-500/10 dark:text-rose-300 dark:ring-rose-400/20">
            <span class="h-1 w-1 rotate-45 bg-current"></span>
            {loc.tag}
          </span>

          <h4 class="relative mt-3  text-xl font-bold text-foreground">{loc.title}</h4>

          <p class="relative mt-2 flex items-start gap-1.5 text-sm text-muted-foreground">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
              <path d="M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
            </svg>
            {loc.place}
          </p>

          <!-- Footer kartu -->
          <div class="relative mt-auto pt-6">
            <div class="flex items-center justify-between gap-3 border-t border-dashed border-border pt-4">
              <span class="text-xs font-semibold text-foreground/80">{loc.program}</span>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-border text-foreground/70 transition-all duration-300 group-hover:border-rose-500 group-hover:bg-rose-500 group-hover:text-white group-hover:rotate-45">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

    
  </div>
</section>

