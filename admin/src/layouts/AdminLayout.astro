---
import '@/styles/global.css';
import Sidebar from '@/components/Sidebar.astro';
import Topbar from '@/components/Topbar.astro';

interface Props {
  title: string;
  breadcrumb?: string;
  activeSub?: 'list' | 'new' | 'categories' | 'tags';
}

const { title, breadcrumb = 'Artikel / Tambah baru' } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Admin Murojaah.id</title>
  </head>
  <body class="min-h-svh bg-background text-foreground antialiased">
    <Sidebar>
      <main id="editor" class="flex flex-col gap-4 py-4 md:gap-6 md:py-6 px-4 lg:px-6">
        <Topbar title={title} breadcrumb={breadcrumb}>
          <slot name="actions" slot="actions" />
        </Topbar>
        <slot />
      </main>
    </Sidebar>
  </body>
</html>
