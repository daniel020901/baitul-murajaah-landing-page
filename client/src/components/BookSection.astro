    arabicTitle: 'فقه مختصر',
    category: 'KITAB FIQIH',
    price: 85000,
    originalPrice: 110000,
    badge: 'NEW ARRIVAL',
    image: 'https://images.unsplash.com/photo-1590080875515-8a3a8dc5735e?q=80&w=600&auto=format&fit=crop',
    author: 'Syaikh Abu Syuja',
    publisher: 'Murojaah Press Indonesia',
