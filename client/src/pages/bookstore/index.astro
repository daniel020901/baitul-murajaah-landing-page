---
import '@/styles/global.css';
import BaseLayout from '@/layouts/baseLayout.astro';
import BookstoreCatalog from '@/components/ui/BookstoreCatalog';

const title = 'Bookstore';
---

<BaseLayout title={title}>
  {/* ── BREADCRUMB ── */}
  <div class="border-b border-border bg-card/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
      <nav class="flex items-center gap-2 text-xs text-muted-foreground font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span class="text-border" aria-hidden="true">/</span>
        <span class="text-foreground font-semibold" aria-current="page">Bookstore</span>
      </nav>
    </div>
  </div>

  <main class="min-h-screen pb-24 bg-background text-foreground">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
      {/* ── HERO BANNER ── */}
      <header class="relative overflow-hidden rounded-3xl border border-border text-white p-8 sm:p-14 mb-12 min-h-[320px] flex flex-col justify-center">
        {/* Background Image Banner dari /banner_yt.jpg */}
        <img
          src="/banner_yt.jpg"
          alt="Banner Bookstore Baitul Murojaah"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="eager"
        />

        {/* Subtle Dark Vignette Overlay untuk keterbacaan teks tanpa menutupi ornamen banner */}
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/35" aria-hidden="true" />

        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/40 backdrop-blur-xs text-white border border-white/20 text-[11px] font-extrabold tracking-widest uppercase mb-4">
            
            Toko Buku &amp; Mushaf Huffadz
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white">
            Penerbitan Mushaf &amp; Kitab Rujukan
          </h1>

          <p class="text-sm sm:text-base text-white/90 mt-4 leading-relaxed font-normal">
            Koleksi resmi Baitul Murojaah: Mushaf berfitur blok warna tikrar, kitab matan tajwid bersanad, syarah fiqih madzhab Syafi'i, dan buku panduan mutasyabihat.
          </p>

          {/* Fitur Keunggulan */}
          <div class="mt-8 flex flex-wrap items-center gap-4 sm:gap-6 pt-6 border-t border-white/20 text-xs text-white/95">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Tashih Resmi Kemenag RI</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Metode Tikrar Teruji</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Kertas QPP Premium Khusus Mushaf</span>
            </div>
          </div>
        </div>
      </header>

      {/* ── KATALOG INTERAKTIF (SEARCH, FILTER & PAGINATION) ── */}
      <BookstoreCatalog client:load />
    </div>
  </main>
</BaseLayout>