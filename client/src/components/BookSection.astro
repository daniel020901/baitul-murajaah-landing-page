---
import BookCard from '@/components/ui/bookCard';
import { featuredProducts } from '@/data/mock';
---

<section id="toko" class="py-24 relative z-10 bg-background">
  <div class="max-w-6xl mx-auto px-6">
    {/* Header Section */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.24em] text-r600 uppercase mb-2">
          <span class="w-7 h-[2px] bg-r600 rounded-full" />
          Bookstore Murojaah.id
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          Penerbitan Mushaf & Kitab <span class="text-r600">Rujukan Huffadz</span>
        </h2>
        <p class="text-sm text-muted-foreground mt-2 max-w-xl">
          Koleksi mushaf pilihan berfitur blok warna tikrar dan kitab hadits terbitan resmi Baitul Murojaah.
        </p>
      </div>

      <a
        href="/bookstore"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-border bg-card text-foreground text-xs font-semibold uppercase tracking-wider hover:bg-foreground hover:text-background transition-colors self-start md:self-end"
      >
        <span>Lihat Semua Katalog</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    {/* Grid Kartu Produk Unggulan (Hanya dengan Badge) */}
    <BookCard products={featuredProducts} client:visible />
  </div>
</section>