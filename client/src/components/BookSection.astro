    arabicTitle: 'مُصْحَفُ الحُفَّاظِ',
    category: 'MUSHAF STANDAR',
    price: 185000,
    originalPrice: 220000,
    badge: 'BESTSELLER',
    image: 'https://images.unsplash.com/photo-1603808033176-9d134e6f2c74?q=80&w=600&auto=format&fit=crop',
    author: 'Tim Lajnah Pentashih Al-Qur\'an',
    publisher: 'Murojaah Press Indonesia',
    pages: 604,
    isbn: '978-602-1234-56-7',
    language: 'Arab & Terjemah Kemenag RI',
    paperType: 'QPP (Quran Paper Premium)',
    description: 'Mushaf khusus dirancang untuk para penghafal Al-Qur\'an. Dilengkapi dengan blok warna penanda maqtha tikrar, kata kunci awal ayat di margin kiri-kanan, dan pembagian juz yang presisi.',
    highlights: [
      'Fitur Blok Warna Tikrar 20x per Halaman',
