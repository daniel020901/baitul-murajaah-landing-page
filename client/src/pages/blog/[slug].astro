---
import '@/styles/global.css';
import '@/styles/blog-detail.css';
import BaseLayout from '@/layouts/baseLayout.astro';
import { articles, categories, recentPosts } from '@/data/mock';

// ── Static paths ──────────────────────────────────────────────
export function getStaticPaths() {
  return articles.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Artikel terkait: ambil 3 artikel selain yang sedang dibuka, kategori sama (prioritas) lalu acak
const related = articles
  .filter((a) => a.slug !== post.slug)
  .sort((a) => (a.category === post.category ? -1 : 1))
  .slice(0, 3);
---

<BaseLayout title={post.title}>

  <!-- ═══════════════════ BANNER HERO (gambar penuh JPG) ═══════════════ -->
  <div class="post-banner">
    <img
      src={post.image}
      alt={post.alt}
      class="post-banner__img"
      loading="eager"
      decoding="async"
      width="1400"
      height="480"
    />
    <div class="post-banner__overlay"></div>
  </div>

  <!-- ═══════════════════ BREADCRUMB ═══════════════════════════════════ -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="breadcrumb__current">{post.title}</span>
      </nav>
    </div>
  </div>

  <!-- ═══════════════════ MAIN CONTENT ═════════════════════════════════ -->
  <div class="container post-layout">

    <!-- ── Kiri: Konten Artikel ── -->
    <main class="post-main">

      <!-- Meta baris -->
      <div class="post-meta">
        <span class="post-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          {post.author}
        </span>
        <span class="post-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <time datetime={post.dateIso}>{post.date}</time>
        </span>
        <span class="post-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          {post.category}
        </span>
      </div>

      <!-- Judul Artikel -->
      <h1 class="post-title">{post.title}</h1>

      <!-- Body artikel -->
      <div class="post-body" set:html={post.body ?? `<p>${post.excerpt}</p>`} />

      <!-- Social Share -->
      <div class="post-share">
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-btn--fb"
          aria-label="Bagikan ke Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(post.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-btn--tw"
          aria-label="Bagikan ke Twitter/X"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
        </a>
        <a
          href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(post.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-btn--li"
          aria-label="Bagikan ke LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>

      <!-- Related Articles -->
      {related.length > 0 && (
        <section class="related-section">
          <h2 class="related-title">Artikel Terkait</h2>
          <div class="related-grid">
            {related.map((rel) => (
              <a href={`/blog/${rel.slug}`} class="related-card">
                <img
                  src={rel.image.replace('w=1200&h=750', 'w=500&h=300')}
                  alt={rel.alt}
                  width="500"
                  height="300"
                  loading="lazy"
                  decoding="async"
                  class="related-card__img"
                />
                <div class="related-card__body">
                  <span class="related-card__cat">{rel.category}</span>
                  <p class="related-card__title">{rel.title}</p>
                  <span class="related-card__date">{rel.date}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- ── Kanan: Sidebar ── -->
    <aside class="blog-sidebar">

      <!-- Search -->
      <div class="sidebar-widget">
        <h3 class="sidebar-widget__title">Search</h3>
        <form class="sidebar-search" role="search" action="/blog/search">
          <input
            id="slug-search-input"
            type="search"
            name="q"
            placeholder="Cari artikel..."
            class="sidebar-search__input"
            aria-label="Cari artikel"
          />
          <button type="submit" class="sidebar-search__btn">Search</button>
        </form>
      </div>

      <!-- Recent Posts -->
      <div class="sidebar-widget">
        <h3 class="sidebar-widget__title">Recent Posts</h3>
        <ul class="recent-posts">
          {recentPosts.map((p) => (
            <li class="recent-post">
              <a href={`/blog/${p.slug}`} class="recent-post__thumb-link" tabindex="-1">
                <img
                  src={p.image}
                  alt={p.title}
                  width="80"
                  height="60"
                  loading="lazy"
                  decoding="async"
                  class="recent-post__thumb"
                />
              </a>
              <div class="recent-post__info">
                <a href={`/blog/${p.slug}`} class={`recent-post__title${p.slug === post.slug ? ' is-active' : ''}`}>
                  {p.title}
                </a>
                <span class="recent-post__date">{p.date}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories -->
      <div class="sidebar-widget">
        <h3 class="sidebar-widget__title">Categories</h3>
        <ul class="sidebar-categories">
          {categories.map((cat) => (
            <li>
              <a href={`/blog?category=${encodeURIComponent(cat)}`} class={`sidebar-cat-link${cat === post.category ? ' is-active' : ''}`}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </aside>
  </div>

</BaseLayout>


