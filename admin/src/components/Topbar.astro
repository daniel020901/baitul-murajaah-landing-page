---
interface Props {
  breadcrumb?: string;
  title: string;
}

const { breadcrumb = 'Artikel / Tambah baru', title } = Astro.props;
---

<header class="flex flex-wrap items-center justify-between gap-4 pb-2">
  <div>
    <div class="text-[13px] text-[#5b6472] font-medium">{breadcrumb}</div>
    <h1 class="mt-1 text-[26px] font-bold tracking-[-0.01em] text-[#1b2430] leading-tight">
      {title}
    </h1>
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <slot name="actions" />
  </div>
</header>
