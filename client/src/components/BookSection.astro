---

<section id="toko" class="py-24 relative z-10">
      <div class="max-w-6xl mx-auto px-6">
        {/* Header */}
        <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-extrabold tracking-[0.24em] text-r600 uppercase mb-2">
              <span class="w-7 h-[2px] bg-r600 rounded-full" />
              Bookstore Murojaah.id
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
              Penerbitan Mushaf & Kitab <span class="grad-text">Rujukan Huffadz</span>
            </h2>
          </div>
          
        </div>

        {/* Product Cards Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((p) => (
            <div
              class="bg-white border border-line rounded-3xl p-4 transition-all duration-300 hover:-translate-y-1 hover:border-gray-300 flex flex-col justify-between group relative overflow-hidden"
            >
              {/* Product Cover Box */}
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden flex flex-col items-center justify-center bg-gray-50">
                <img 
                  src={p.image} 
                  alt={p.title} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                {p.badge && (
                  <span class="absolute top-3 left-0 bg-gold text-[#3D2408] text-[9px] font-extrabold tracking-widest px-3 py-1 rounded-r-full shadow-sm z-10">
                    {p.badge}
                  </span>
                )}
              </div>

              {/* Product Info */}
              <div class="p-2 pt-4 flex flex-col justify-between flex-1">
                <div>
                  <span class="text-[10px] font-extrabold tracking-widest uppercase text-mut block">
                    {p.category}
                  </span>
                  <h4 class="text-sm font-extrabold mt-1 leading-snug line-clamp-2">
                    {p.title}
                  </h4>
                  
                </div>

                <div class="mt-4">
                  <div class="flex items-baseline gap-2 mb-3">
                    <b class="text-r600 text-base font-extrabold">
                      Rp {p.price.toLocaleString('id-ID')}
                    </b>
                    <s class="text-mut text-xs">
                      Rp {p.originalPrice.toLocaleString('id-ID')}
                    </s>
                  </div>

                  <button class="w-full mt-2 flex items-center justify-center gap-2 bg-[#9B1C1C] hover:bg-[#771b1b] text-white py-2.5 rounded-xl text-sm font-bold transition-colors">
                    <ShoppingBag  /> Beli Sekarang
                  </button>
                </div>
              </div>

              {/* Modal Hover Popup Overlay */}
              <div class="absolute inset-0 bg-white/95 backdrop-blur-md opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-20 p-5 flex flex-col overflow-y-auto">
                <div class="flex-1">
                  <span class="text-[10px] font-extrabold tracking-widest uppercase text-r600 block mb-1">
                    {p.category}
                  </span>
                  <h4 class="font-extrabold text-sm text-gray-900 mb-1 leading-snug">{p.title}</h4>
                  <p class="text-[10px] text-gray-500 mb-3">{p.author} • {p.pages} hlm</p>
                  
                  <p class="text-xs text-gray-700 mb-4 leading-relaxed line-clamp-4">{p.description}</p>
                  
                  <div class="mb-4">
                    <span class="text-[10px] font-extrabold tracking-widest uppercase text-mut block mb-2">Highlights</span>
                    <ul class="text-xs text-gray-600 space-y-1.5">
                      {p.highlights.map((hl) => (
                        <li class="flex items-start gap-2">
                          <span class="text-r600 mt-0.5">•</span>
                          <span class="leading-snug">{hl}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                
                <div class="pt-4 border-t border-gray-100 flex items-center justify-between gap-3 mt-4 shrink-0">
                  <div class="flex-1">
                    <span class="text-[10px] text-gray-500 block">Kertas</span>
                    <span class="text-xs font-bold text-gray-800 line-clamp-1">{p.paperType}</span>
                  </div>
                  <button class="bg-[#9B1C1C] hover:bg-[#771b1b] text-white p-2.5 cursor-pointer rounded-xl transition-colors shrink-0">
                    <ShoppingBag  />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>