---
---

<section id="tentang" class="py-20 md:py-28 relative z-10 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
    
    <!-- Header Section -->
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-16 md:mb-20">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary text-secondary-foreground text-xs uppercase tracking-widest font-semibold mb-3">
        Tentang Kami
      </span>

      <h2 class=" text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground uppercase mb-5">
        Baitul Murojaah
      </h2>

      <p class="font-sans text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl">
        Program Pembinaan 1 Tahun Bagi Para Penghafal Al-Qur'an di Bawah Bimbingan 
        <span class="font-semibold text-foreground"> Dr. K.H. Deden Muhammad Makhyaruddin, M.A., Alhafizh </span>  
         untuk Menguatkan Hafalan 30 Juz Al-Qur’an secara mutqin dan bersanad muttashil.
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- KOLOM KIRI: Accordion & Latar Ornamen Halus -->
      <div class="lg:col-span-7 relative flex flex-col justify-center">
        
        <!-- Accordion Card Wrapper (Ditengahkan dengan Border & BG-Card) -->
        <div class="relative w-full max-w-2xl mx-auto lg:mx-0">
          
          <!-- Ornamen Latar Halus (Concentric Circles & Garis Halus Sesuai Referensi) -->
          <div class="absolute -top-10 -right-8 w-56 h-56 pointer-events-none opacity-20 -z-10">
            <svg viewBox="0 0 200 200" class="w-full h-full text-[#38a3c8]" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="100" cy="100" r="24" stroke-opacity="0.3" />
              <circle cx="100" cy="100" r="48" stroke-opacity="0.4" />
              <circle cx="100" cy="100" r="72" stroke-opacity="0.5" />
              <circle cx="100" cy="100" r="94" stroke-opacity="0.6" />
            </svg>
          </div>

          <!-- Card Container dengan Border & Pembatas Antar-Item -->
          <div class="rounded-xl border border-border bg-card shadow-xs overflow-hidden divide-y divide-border">
            
            <!-- ITEM 1: Keunggulan Murojaah & Sanad -->
            <div class="accordion-item transition-colors">
              <button
                type="button"
                class="accordion-trigger w-full px-5 py-4 sm:px-6 sm:py-5 flex items-center gap-3.5 sm:gap-4 text-left group transition-colors hover:bg-muted/30"
                aria-expanded="false"
              >
                <span class="icon-toggle text-xl sm:text-2xl  text-[#38a3c8] dark:text-[#45b7e3] group-hover:scale-110 transition-transform select-none font-semibold leading-none">
                  +
                </span>
                <span class=" text-lg sm:text-xl md:text-2xl font-normal tracking-wide text-[#38a3c8] dark:text-[#45b7e3] transition-colors">
                  Keunggulan Baitul Murojaah
                </span>
              </button>
              <div class="accordion-content px-5 sm:px-6 pb-5 pt-1 text-sm sm:text-base text-muted-foreground leading-relaxed hidden">
                <p class="mb-3.5">
                  Metode intensif pembinaan tikrar dan pemeliharaan hafalan bersanad untuk mencetak huffadz mutqin yang menguasai literatur Islam.
                </p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1 text-foreground/90 font-medium text-xs sm:text-sm">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#38a3c8]"></span>
                    Metode Tikrar Terstruktur &amp; Intensif
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#38a3c8]"></span>
                    Ijazah Sanad Al-Qur'an Muttashil
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#38a3c8]"></span>
                    Kajian Hadits &amp; Majelis Shahih Bukhari
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#38a3c8]"></span>
                    Bimbingan Langsung Dewan Masyayikh
                  </li>
                </ul>
              </div>
            </div>

            <!-- ITEM 2: Visi & Misi Yayasan -->
            <div class="accordion-item transition-colors">
              <button
                type="button"
                class="accordion-trigger w-full px-5 py-4 sm:px-6 sm:py-5 flex items-center gap-3.5 sm:gap-4 text-left group transition-colors hover:bg-muted/30"
                aria-expanded="false"
              >
                <span class="icon-toggle text-xl sm:text-2xl  text-[#38a3c8] dark:text-[#45b7e3] group-hover:scale-110 transition-transform select-none font-semibold leading-none">
                  +
                </span>
                <span class=" text-lg sm:text-xl md:text-2xl font-normal tracking-wide text-[#38a3c8] dark:text-[#45b7e3] transition-colors">
                  Visi &amp; Misi Yayasan
                </span>
              </button>
              <div class="accordion-content px-5 sm:px-6 pb-5 pt-1 text-sm sm:text-base text-muted-foreground leading-relaxed hidden">
                <div class="space-y-4 pt-1">
                  <div>
                    <h4 class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded bg-[#38a3c8]"></span> Visi
                    </h4>
                    <p class="text-xs sm:text-sm text-muted-foreground">
                      Menjadi pusat peradaban Al-Qur'an dan Sunnah unggulan dalam menjaga hafalan para huffadz, menghidupkan kajian hadits, serta mencetak generasi berakhlak mulia dan berwawasan luas.
                    </p>
                  </div>
                  <div>
                    <h4 class="font-bold text-foreground text-xs uppercase tracking-wider mb-1 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded bg-amber-500"></span> Misi
                    </h4>
                    <p class="text-xs sm:text-sm text-muted-foreground">
                      Menyelenggarakan sistem murojaah berkala, dauroh intensif, majelis Shahih Bukhari, serta membangun kemandirian dakwah melalui Media Murojaah, Bookstore, dan Infaq Murojaah.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- ITEM 3: Ekosistem Program & Lokasi -->
            <div class="accordion-item transition-colors">
              <button
                type="button"
                class="accordion-trigger w-full px-5 py-4 sm:px-6 sm:py-5 flex items-center gap-3.5 sm:gap-4 text-left group transition-colors hover:bg-muted/30"
                aria-expanded="false"
              >
                <span class="icon-toggle text-xl sm:text-2xl  text-[#38a3c8] dark:text-[#45b7e3] group-hover:scale-110 transition-transform select-none font-semibold leading-none">
                  +
                </span>
                <span class=" text-lg sm:text-xl md:text-2xl font-normal tracking-wide text-[#38a3c8] dark:text-[#45b7e3] transition-colors">
                  Pusat Kegiatan &amp; Majelis
                </span>
              </button>
              <div class="accordion-content px-5 sm:px-6 pb-5 pt-1 text-sm sm:text-base text-muted-foreground leading-relaxed hidden">
                <p class="mb-3.5">
                  Penyelenggaraan agenda bimbingan Al-Qur'an dan kajian yang tersebar di titik-titik resmi:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm font-medium text-foreground/90">
                  <div>
                    <span class="text-[#38a3c8] dark:text-[#45b7e3] font-bold block">Mihrab Masyayikh</span>
                    <span class="text-muted-foreground">Kediaman KH. Deden (Cibinong)</span>
                  </div>
                  <div>
                    <span class="text-[#38a3c8] dark:text-[#45b7e3] font-bold block">Dauroh Murojaah</span>
                    <span class="text-muted-foreground">Masjid Nur Inka</span>
                  </div>
                  <div>
                    <span class="text-[#38a3c8] dark:text-[#45b7e3] font-bold block">Murojaah Camp</span>
                    <span class="text-muted-foreground">Taman Jati Kembang Sepatu</span>
                  </div>
                  <div>
                    <span class="text-[#38a3c8] dark:text-[#45b7e3] font-bold block">Baitul Murojaah</span>
                    <span class="text-muted-foreground">Pusat Asrama &amp; Kurikulum Santri</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- KOLOM KANAN: Foto Kyai Menyatu dengan Canvas -->
      <div class="lg:col-span-5 flex flex-col items-center text-center">
        
        <!-- Label Gelar / Status -->
        <div class="mb-3 inline-flex items-center gap-2 px-3.5 py-1 rounded-[5px]  text-secondary-foreground text-md font-semibold">
          
          Pembina &amp; Pengasuh Utama
        </div>

        <!-- Gambar Kyai langsung di canvas -->
        <div class="relative w-full flex justify-center py-2">
          <img
            src="/Kyai-clean.png"
            alt="Dr. K.H. Deden Muhammad Makhyaruddin, M.A."
            class="w-full max-w-[300px] sm:max-w-[340px] h-auto object-contain transition-transform duration-500 hover:scale-[1.02]"
            loading="lazy"
          />
        </div>

        <!-- Keterangan Tokoh -->
        <div class="mt-2 space-y-1">
          <h3 class=" font-bold text-foreground text-lg sm:text-xl">
            Dr. K.H. Deden Muhammad Makhyaruddin, M.A.
          </h3>
          <p class="text-xs text-muted-foreground font-medium">
            Pakar Kaidah &amp; Sanad Al-Qur'an 30 Juz • Juara 1 MHQ Internasional (Maroko)
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Script Accordion Interaktif Sederhana & Cepat -->
<script>
  function setupAccordion() {
    const items = document.querySelectorAll<HTMLElement>('.accordion-item');

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.accordion-trigger');
      const content = item.querySelector<HTMLElement>('.accordion-content');
      const icon = item.querySelector<HTMLElement>('.icon-toggle');

      if (!trigger || !content || !icon) return;
      if (trigger.dataset.accordionInit === 'true') return;
      trigger.dataset.accordionInit = 'true';

      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        // Tutup panel lain
        items.forEach((otherItem) => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector<HTMLButtonElement>('.accordion-trigger');
            const otherContent = otherItem.querySelector<HTMLElement>('.accordion-content');
            const otherIcon = otherItem.querySelector<HTMLElement>('.icon-toggle');

            if (otherTrigger && otherContent && otherIcon) {
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherContent.classList.add('hidden');
              otherIcon.textContent = '+';
            }
          }
        });

        // Toggle panel aktif
        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          content.classList.add('hidden');
          icon.textContent = '+';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          content.classList.remove('hidden');
          icon.textContent = '−';
        }
      });
    });
  }

  setupAccordion();
  document.addEventListener('astro:page-load', setupAccordion);
</script>
